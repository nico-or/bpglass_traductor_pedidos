{
  "compilerOptions": {
    "target": "ES2022", // TODO: verify config
    "module": "ESNext", // TODO: verify config
    "moduleResolution": "Node",
    "outDir": "./dist",
    "rootDir": "./src",
    "allowJs": true,
    "checkJs": false, // TODO: verify config
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
